# Solana Tracker JSON-RPC (required)
# Prefer a dedicated Secure RPC host. The shared rpc-mainnet host is often Cloudflare-blocked.
SECURE_RPC_URL=
SOLANA_TRACKER_RPC_URL=
SOLANA_TRACKER_ACCESS_KEY=
SOLANA_TRACKER_API_KEY=

# Helius wallet-identity REST only (optional). JSON-RPC does not need this.
HELIUS_API_KEY=

COMMITMENT=confirmed

# Optional hosted cache
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only hosted mode
# TRICKSHOT_READONLY=1
